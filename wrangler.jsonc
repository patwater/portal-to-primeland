{
  "name": "portal-to-primeland",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // Omit `id` and wrangler provisions the KV namespace on first deploy (wrangler 4.45+).
  "kv_namespaces": [{ "binding": "BOOKS" }],
  "ratelimits": [{ "name": "GEN_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }],
  // Custom domain: uncomment and use a domain on your Cloudflare account, then `npm run deploy`.
  // "routes": [{ "pattern": "primeland.example.com", "custom_domain": true }],
  // Makes the Worker's console.log lines (cache counts, error reasons; never family details) visible in the dashboard.
  "observability": { "enabled": true },
  "vars": {
    "MODEL_STORY": "claude-sonnet-5-5",
    "MODEL_ART": "claude-sonnet-5-5",
    "MODEL_INTERVIEW": "claude-haiku-5-5",
    "DAILY_BOOK_BUDGET": "200",
    // New books per anonymous browser session (a cookie), how long a session lasts, and a daily cap per IP address.
    "SESSION_BOOK_LIMIT": "2",
    "SESSION_TTL_HOURS": "24",
    "IP_DAILY_BOOK_LIMIT": "6",
    // "false" turns the Turnstile check off (the rate limit and daily budget still apply). Remove the line or set "true" to turn it back on.
    "TURNSTILE_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "42",
    "BOOK_TTL_DAYS": "400"
  }
  // Secrets (never in this file): ANTHROPIC_API_KEY, TURNSTILE_SECRET_KEY, STUDIO_PASSWORD.
}
